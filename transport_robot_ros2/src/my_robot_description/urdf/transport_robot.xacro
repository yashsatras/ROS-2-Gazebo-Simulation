        <slip1>0.0</slip1>
        <slip2>0.0</slip2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <max_contacts>8</max_contacts>
    </gazebo>

    <gazebo reference="link12">
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
        <slip1>0.0</slip1>
        <slip2>0.0</slip2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <max_contacts>8</max_contacts>
    </gazebo>

    <!-- ========================================================= -->
    <!-- ROS 2 CONTROL                                             -->
    <!-- ========================================================= -->

    <ros2_control name="TransportRobotSystem" type="system">

        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <!-- Front-left -->
        <joint name="link5_Revolute-25">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Rear-left -->
        <joint name="link6_Revolute-26">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Rear-right -->
        <joint name="link7_Revolute-27">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Front-right -->
        <joint name="link8_Revolute-28">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

    </ros2_control>
<!-- ========================================================= -->
<!-- GAZEBO ROS 2 CONTROL                                      -->
<!-- ========================================================= -->

<gazebo>
    <plugin
        filename="gz_ros2_control-system"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">

        <parameters>
            /home/rostheboss/transport_robot_ros2/src/my_robot_bringup/config/controllers.yaml
