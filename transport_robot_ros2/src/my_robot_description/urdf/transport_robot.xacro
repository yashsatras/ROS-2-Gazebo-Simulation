    <!-- CAMERA STAND JOINT                                         -->
    <!-- ========================================================= -->

    <joint name="base_link_to_camera_stand"
           type="fixed">

        <!-- Camera stand mounted at the CENTER of the robot -->
        <origin xyz="0 0 0.01"
                rpy="0 0 0"/>

        <parent link="base_link"/>
        <child link="camera_stand_link"/>

    </joint>


    <!-- ========================================================= -->
    <!-- CAMERA JOINT                                               -->
    <!-- ========================================================= -->

    <joint name="camera_stand_to_camera"
           type="fixed">

        <!-- Top of 300 mm camera stand -->
        <origin xyz="0 0 0.30"
                rpy="0 0 0"/>

        <parent link="camera_stand_link"/>
        <child link="camera_link"/>

    </joint>



    <!-- ========================================================= -->
    <!-- LIDAR MOUNT JOINT                                          -->
    <!-- ========================================================= -->

    <joint name="camera_stand_to_lidar" type="fixed">
        <!-- LiDAR is centered above the camera stand -->
        <origin xyz="0 0 0.35" rpy="0 0 0"/>
        <parent link="camera_stand_link"/>
        <child link="lidar_link"/>
    </joint>

    <!-- ========================================================= -->
    <!-- CAMERA OPTICAL FRAME JOINT                                 -->
    <!-- ========================================================= -->

    <joint name="camera_optical_joint"
           type="fixed">

        <!-- ROS optical frame convention -->
        <origin xyz="0 0 0"
                rpy="-1.57079632679 0 -1.57079632679"/>

        <parent link="camera_link"/>
        <child link="camera_optical_frame"/>

    </joint>

<gazebo reference="camera_link">

    <sensor name="custom_camera" type="camera">

        <always_on></always_on>
        <update_rate>30.0</update_rate>
        <visualize>true</visualize>

        <topic>/camera/image_raw</topic>

        <camera>

            <horizontal_fov>1.3962634</horizontal_fov>

            <image>
                <width>1920</width>
                <height>1080</height>
                <format>R8G8B8</format>
            </image>

            <clip>
                <near>0.1</near>
                <far>15.0</far>
            </clip>

            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.007</stddev>
            </noise>

        </camera>

    </sensor>

</gazebo>

    <!-- ========================================================= -->
    <!-- GAZEBO 2D GPU LIDAR SENSOR                                 -->
    <!-- ========================================================= -->

    <gazebo reference="lidar_link">
        <sensor name="lidar_sensor" type="gpu_lidar">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10.0</update_rate>
            <topic>/scan</topic>

            <lidar>
                <scan>
                    <horizontal>
                        <samples>720</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159265359</min_angle>
                        <max_angle>3.14159265359</max_angle>
                    </horizontal>
                </scan>

                <range>
                    <min>0.12</min>
                    <max>20.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.005</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>


    <!-- ========================================================= -->
    <!-- GAZEBO OMNI-WHEEL CONTACT PHYSICS                        -->
    <!-- ========================================================= -->

    <gazebo reference="link9">
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
        <slip1>0.0</slip1>
        <slip2>0.0</slip2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <max_contacts>8</max_contacts>
    </gazebo>

    <gazebo reference="link10">
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
