        <visual name="camera_visual">

            <origin xyz="0 0 0"
                    rpy="0 0 0"/>

            <geometry>
                <box size="0.06 0.04 0.04"/>
            </geometry>

        </visual>

        <collision name="camera_collision">

            <origin xyz="0 0 0"
                    rpy="0 0 0"/>

            <geometry>
                <box size="0.06 0.04 0.04"/>
            </geometry>

        </collision>

    </link>



