            <origin xyz="0 0 0.15"
                    rpy="0 0 0"/>

            <geometry>
                <cylinder radius="0.01"
                           length="0.30"/>
            </geometry>

        </visual>

        <collision name="camera_stand_collision">

            <origin xyz="0 0 0.15"
                    rpy="0 0 0"/>

