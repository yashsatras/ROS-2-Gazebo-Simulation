    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LaserScan1
        - /LaserScan2
        - /Map1
        - /Map1/Status1
        - /Map1/Topic1
      Splitter Ratio: 0.5
    Tree Height: 332
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
