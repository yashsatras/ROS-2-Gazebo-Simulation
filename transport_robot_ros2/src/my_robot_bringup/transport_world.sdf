    <!-- ========================================================= -->
    <!-- RED SOLID WOODEN RAMP                                    -->
    <!-- Length: 3.5 m                                           -->
    <!-- Width: 1.0 m                                            -->
    <!-- ========================================================= -->

    <model name="solid_wooden_ramp">

      <static>true</static>

      <link name="link">

        <pose>
          -3 2.7 0 1.57 0 -1.57
        </pose>

        <collision name="collision">

          <geometry>

            <polyline>

              <height>1</height>

              <point>
                0 0
              </point>

              <point>
                3.5 0
              </point>

              <point>
                3.5 0.375
              </point>

            </polyline>

          </geometry>

          <surface>

            <friction>

              <ode>
                <mu>0.8</mu>
                <mu2>0.7</mu2>
              </ode>

            </friction>

          </surface>

        </collision>


