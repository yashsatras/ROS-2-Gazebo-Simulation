<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="robocon_test_field">

    <!-- ========================================================= -->
    <!-- WORLD PHYSICS                                             -->
    <!-- ========================================================= -->

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>


    <!-- ========================================================= -->
    <!-- GAZEBO SYSTEM PLUGINS                                     -->
    <!-- ========================================================= -->

    <!-- Physics -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <!-- User commands -->
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <!-- Publishes scene information to Gazebo GUI -->
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <!-- ========================================================= -->
    <!-- IMPORTANT: SENSOR SYSTEM                                 -->
    <!-- Required for camera and GPU LiDAR                        -->
    <!-- ========================================================= -->

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>


    <!-- ========================================================= -->
    <!-- SUN / LIGHT                                               -->
    <!-- ========================================================= -->

    <light name="sun" type="directional">

      <pose>0 0 10 0 0 0</pose>

      <cast_shadows>true</cast_shadows>

      <diffuse>
        0.8 0.8 0.8 1
      </diffuse>

      <specular>
        0.2 0.2 0.2 1
      </specular>

      <direction>
        -0.5 0.5 -1
      </direction>

    </light>


    <!-- ========================================================= -->
    <!-- PINK HALF                                                 -->
    <!-- Size: 5.5 m x 11 m                                      -->
    <!-- Center: x = -2.75 m                                      -->
    <!-- ========================================================= -->

    <model name="pink_half">

      <static>true</static>

      <pose>
        -2.75 0 -0.05 0 0 0
      </pose>

      <link name="pink_floor">

        <collision name="pink_collision">

          <geometry>

            <box>
              <size>
                5.5 11 0.1
              </size>
            </box>

          </geometry>

        </collision>


        <visual name="pink_visual">

          <geometry>

            <box>
              <size>
                5.5 11 0.1
              </size>
            </box>

          </geometry>

          <material>

            <ambient>
              0.996 0.875 0.867 1
            </ambient>

            <diffuse>
              0.996 0.875 0.867 1
            </diffuse>

            <specular>
              0.05 0.05 0.05 1
            </specular>

          </material>

        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- BLUE HALF                                                 -->
    <!-- Size: 5.5 m x 11 m                                      -->
    <!-- Center: x = +2.75 m                                      -->
    <!-- ========================================================= -->

